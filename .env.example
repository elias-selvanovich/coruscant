# Copiá este archivo a .env.local (para `vercel dev`) y completá los valores.
# En producción, cargá estas mismas variables en Vercel → Project → Settings → Environment Variables.

# --- Supabase (Project Settings → API) ---
SUPABASE_URL=https://xxxxxxxx.supabase.co
# ⚠️ Service Role key: SOLO en el servidor. Nunca la pongas en el frontend.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Resend (https://resend.com/api-keys) ---
RESEND_API_KEY=re_...
# Remitente. Para probar rápido podés usar onboarding@resend.dev.
# En producción, un mail de un dominio verificado (ej: reservas@selvanovich.com.ar).
FROM_EMAIL=Coruscant <reservas@selvanovich.com.ar>
# A quién avisamos cuando alguien reserva (separá varios con coma).
NOTIFY_EMAILS=elias.selvanovich@gmail.com,segundo@ejemplo.com
