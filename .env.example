# Copiá este archivo a .env.local (para `vercel dev`) y completá los valores.
# En producción, cargá estas mismas variables en Vercel → Project → Settings → Environment Variables.

# --- Turso (dashboard → Databases, o CLI `turso`) ---
# URL de la base libSQL (empieza con libsql://).
TURSO_DATABASE_URL=libsql://coruscant-tu-usuario.turso.io
# Token de auth (turso db tokens create coruscant). SOLO en el servidor.
TURSO_AUTH_TOKEN=eyJ...

# --- Resend (https://resend.com/api-keys) ---
RESEND_API_KEY=re_...
# Remitente. Para probar rápido podés usar onboarding@resend.dev.
# En producción, un mail de un dominio verificado (ej: reservas@selvanovich.ar).
FROM_EMAIL=Coruscant <reservas@selvanovich.ar>
# A quién avisamos cuando alguien reserva (separá varios con coma).
NOTIFY_EMAILS=elias.selvanovich@gmail.com,segundo@ejemplo.com
